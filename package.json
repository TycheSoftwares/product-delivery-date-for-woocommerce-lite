{
  "name": "product-delivery-date-for-woocommerce-lite",
  "version": "4.0.0",
  "private": true,
  "description": "Product Delivery Date for WooCommerce - Lite - React admin screens.",
  "author": "TycheSoftwares<support@tychesoftwares.com>",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "@wordpress/api-fetch": "^7.19.0",
    "@wordpress/components": "^29.5.0",
    "@wordpress/element": "^6.19.0",
    "@wordpress/hooks": "^4.19.0",
    "@wordpress/i18n": "^5.19.0",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@wordpress/eslint-plugin": "^22.0.0",
    "@wordpress/scripts": "^30.7.0",
    "eslint": "^8.57.1",
    "prettier": "npm:wp-prettier@3.0.3",
    "sass": "^1.83.0",
    "typescript": "^5.8.3"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@wordpress/eslint-plugin/recommended"
    ],
    "globals": {
      "jQuery": true,
      "Choices": true
    },
    "rules": {
      "jsx-a11y/anchor-is-valid": "off",
      "jsx-a11y/click-events-have-key-events": "off",
      "jsx-a11y/no-static-element-interactions": "off",
      "jsx-a11y/label-has-associated-control": "off",
      "jsx-a11y/no-noninteractive-element-interactions": "off",
      "jsx-a11y/no-noninteractive-tabindex": "off"
    }
  },
  "scripts": {
    "build": "wp-scripts build admin-settings=./src/admin-settings/index.js product-metabox=./src/product-metabox/index.js",
    "start": "wp-scripts start admin-settings=./src/admin-settings/index.js product-metabox=./src/product-metabox/index.js",
    "format": "wp-scripts format ./src",
    "lint:js": "wp-scripts lint-js ./src",
    "i18n:pot": "php -d memory_limit=512M \"$(which wp)\" i18n make-pot . languages/product-delivery-date-for-woocommerce-lite.pot --exclude=node_modules,vendor"
  },
  "overrides": {
    "prettier": "npm:wp-prettier@3.0.3"
  }
}
