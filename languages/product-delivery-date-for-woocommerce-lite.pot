msgid "Update Delivery Date & Time on Renewal:"
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:306
msgid "On every renewal order, the plugin automatically calculates and assigns the next valid delivery date based on: previous delivery date, billing schedule, minimum delivery time, cut-off times, blackout dates, and non-working days. Delivery lockout & charges are also updated on the renewal order. This is always active when Subscription Compatibility is enabled — no separate toggle is required."
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:313
msgid "Always active when compatibility is enabled"
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:334
msgid "Enable the master toggle above to configure subscription delivery options."
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:355
msgid "How Renewal Delivery Dates Are Calculated"
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:365
msgid "When a renewal order is generated, the plugin automatically determines the next delivery date using the following rules in order:"
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:372
msgid "Start from: last delivery date + subscription billing interval (e.g. +7 days for weekly)."
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:378
msgid "Apply minimum delivery time configured for the product or globally."
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:384
msgid "Apply cut-off time — if the deadline for the candidate date has already passed, advance by one day."
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:390
msgid "Skip blackout / holiday dates."
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:396
msgid "Skip non-working days (weekdays disabled in product or global settings)."
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:402
msgid "Skip dates / time slots that have reached their maximum delivery lockout count."
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:408
msgid "Assign the resulting date to the renewal order and update lockout counts and delivery charges accordingly."
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:420
msgid "<strong>Note:</strong> If no valid date is found within 90 days (e.g. all dates are blocked), the renewal order is flagged and an email notification is sent to the store admin."
msgstr ""

