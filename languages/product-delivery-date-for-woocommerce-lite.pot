msgid "Edge Case Behaviour"
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:451
msgid "Subscription Schedule Change:"
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:460
msgid "If a subscription billing schedule is changed (e.g. weekly → monthly), the new billing interval is automatically used from the next renewal onwards. No manual action is needed."
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:472
msgid "Paused Subscriptions:"
msgstr ""

#: src/admin-settings/screens/integrations/Subscriptions.js:481
